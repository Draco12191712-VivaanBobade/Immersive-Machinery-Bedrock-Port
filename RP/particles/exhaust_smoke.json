{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "immersive:exhaust_smoke",
      "basic_render_parameters": { "material": "particles_alpha", "texture": "textures/particle/particles" }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 2 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.05 },
      "minecraft:emitter_shape_point": { "offset": [ 0, 0, 0 ], "direction": [ 0, 1, 0 ] },
      "minecraft:particle_initial_speed": "math.random(0.35, 0.9)",
      "minecraft:particle_lifetime_expression": { "max_lifetime": "math.random(1.1, 2.4)" },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [ "math.random(-0.15, 0.15)", 0.55, "math.random(-0.15, 0.15)" ],
        "linear_drag_coefficient": 1.1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [ "0.05 + 0.1 * (v.particle_age / v.particle_lifetime)", "0.05 + 0.1 * (v.particle_age / v.particle_lifetime)" ],
        "facing_camera_mode": "lookat_xyz",
        "uv": { "texture_width": 128, "texture_height": 128, "uv": [ 0, 0 ], "uv_size": [ 8, 8 ] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": [ "#c8464240", "#90383838", "#00202020" ],
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
