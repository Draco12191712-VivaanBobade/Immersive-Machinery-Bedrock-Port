      },
      "minecraft:particle_appearance_tinting": {
        "color": { "gradient": [ "#e0ffffff", "#80d8f0ff", "#00c0e0f0" ], "interpolant": "v.particle_age / v.particle_lifetime" }
      },
      "minecraft:particle_appearance_lighting": {}
    }
