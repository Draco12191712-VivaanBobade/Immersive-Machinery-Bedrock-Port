{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "immersive:sonar_ping",
      "basic_render_parameters": { "material": "particles_add", "texture": "textures/particle/particles" }
    },
    "components": {
      "minecraft:emitter_local_space": { "position": true, "rotation": false, "velocity": false },
      "minecraft:emitter_rate_instant": { "num_particles": 48 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.25 },
      "minecraft:emitter_shape_sphere": {
        "offset": [ 0, 0.6, 0 ],
        "radius": 0.7,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": 6.5,
      "minecraft:particle_lifetime_expression": { "max_lifetime": 1.35 },
      "minecraft:particle_motion_dynamic": { "linear_drag_coefficient": 2.4 },
      "minecraft:particle_appearance_billboard": {
        "size": [ "0.09 * (1 - v.particle_age / v.particle_lifetime)", "0.09 * (1 - v.particle_age / v.particle_lifetime)" ],
        "facing_camera_mode": "lookat_xyz",
        "uv": { "texture_width": 128, "texture_height": 128, "uv": [ 0, 0 ], "uv_size": [ 8, 8 ] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": [ "#a0fff0e8", "#60c8f0d0", "#0060c0b0" ],
          "interpolant": "v.particle_age / v.particle_lifetime"
        }
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
